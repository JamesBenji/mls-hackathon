# Guardian - environment variables (placeholders only; never commit real values).
#
# Local dev : copy to backend/.env (the app reads .env from the directory uvicorn starts in).
#
# Format rules:
#   - one KEY=value per line; comments on their OWN line
#   - wrap values that contain backslashes in single quotes
#   - leave a secret empty rather than inventing one; numeric settings must not be empty
# Names = fields of backend/app/config.py, upper-cased (config.py is the source of truth).

# ============================================================== General
# Postgres in production, e.g. a managed instance:
#   postgresql+psycopg://user:password@host:5432/guardian?sslmode=require
# SQLite works for local demos and tests: sqlite:///./guardian.db (relative to backend/).
DATABASE_URL=postgresql+psycopg://guardian:change-me@localhost:5432/guardian
# Public HTTPS base URL that ElevenLabs and Twilio call back: your ngrok URL locally,
# your deployed URL in production. Twilio signatures are validated against it.
PUBLIC_BASE_URL=http://localhost:8000
# Clinic timezone for SMS times, the spoken callback_time and relative dates.
# The DB stores naive UTC. Use the patients' timezone (e.g. America/New_York for US numbers).
TIMEZONE=Europe/Berlin
# true = ElevenLabs/Twilio adapters only log (offline demo). The adapters also fall back to
# mock automatically while their credentials below are missing.
MOCK_TELEPHONY=false

# ============================================================== API protection
# Required X-API-Key header on every non-webhook route. Empty = auth DISABLED (local dev only).
# Generate: openssl rand -hex 32
GUARDIAN_API_KEY=
# Exact browser origins allowed by CORS, comma-separated (e.g. the hosted Flutter web URL).
# Never "*".
CORS_ORIGINS=
# Origins matching this regex are also allowed (default: localhost on any port, for
# `flutter run -d chrome`). Single quotes keep the backslashes intact.
CORS_ORIGIN_REGEX='^https?://(localhost|127\.0\.0\.1)(:\d+)?$'

# ============================================================== Model server (Gemma 4 cloud API)
# API key for the Google Generative Language API (serves the Gemma models).
GEMMA_API_KEY=
# The clinical reasoning model, served by the cloud API.
GEMMA_MODEL=gemma-4-31b-it
# two_stage = question plan + report extraction as separate model calls;
# single = one call does everything (fallback)
CLINICAL_PIPELINE=two_stage
# Timeout in seconds for post-call model requests (report, triage, call-job extraction)
MODEL_TIMEOUT_S=120
# Live-call budget in seconds for the question plan; slower = the doctor's static questions
PLAN_TIMEOUT_S=8
# Max concurrent generations from this app (cloud rate-limit safety)
MODEL_MAX_CONCURRENT=2
# How many past call reports are fed to the model as memory
HISTORY_REPORTS_N=3

# ============================================================== Red-flag thresholds
# PLACEHOLDERS - to be confirmed by a clinician. Any hit sets a minimum urgency of "urgent"
# that the model cannot lower.
REDFLAG_BP_SYSTOLIC_ABOVE=180
REDFLAG_BP_DIASTOLIC_ABOVE=120
# Blood sugar in mg/dL
REDFLAG_GLUCOSE_BELOW=54

# ============================================================== ElevenLabs (voice calls)
# Get/rotate at: ElevenLabs dashboard -> Profile -> API Keys
ELEVEN_API_KEY=
# Conversational AI agent id
ELEVEN_AGENT_ID=
# Id of the Twilio number imported under Phone Numbers
ELEVEN_AGENT_PHONE_NUMBER_ID=
# HMAC secret of the post-call webhook (shown once when you create the webhook)
ELEVEN_WEBHOOK_SECRET=
# Shared secret the agent's webhook tools (and the conversation-initiation webhook) send as
# "Authorization: Bearer <token>". Generate: openssl rand -hex 32
ELEVEN_TOOL_AUTH_TOKEN=
ELEVEN_BASE_URL=https://api.elevenlabs.io

# ============================================================== Twilio (SMS)
# Account SID (AC...)
TWILIO_ACCOUNT_SID=
# API key SID (SK...) and its secret, used to send SMS
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Account auth token, used ONLY to validate X-Twilio-Signature on inbound webhooks
TWILIO_AUTH_TOKEN=
# The purchased voice + SMS number in E.164, e.g. +15551234567
TWILIO_NUMBER=

# ============================================================== Scheduling
# Default "call me back" delay in minutes (use 1 for demos)
CALLBACK_DEFAULT_MINUTES=15
# Retry delay in minutes after a missed or failed call
MISSED_CALL_RETRY_MINUTES=60
# Calls per session before Guardian gives up, texts the patient and flags the doctor
MAX_CALL_ATTEMPTS=3
# In-process APScheduler (callbacks, retries, doctor-scheduled calls); run ONE API process
SCHEDULER_ENABLED=true
# Job store URL; empty = DATABASE_URL (jobs survive restarts)
SCHEDULER_JOBSTORE_URL=

# ============================================================== Email (Gmail SMTP)
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_ADDRESS=
# 16-char app password (no spaces)
GMAIL_APP_PASSWORD=
EMAIL_FROM=guardian@example.com
DOCTOR_ALERT_EMAIL=

# ============================================================== Patient photo sync
# Private writable persistent directory; never expose through a static web server.
PHOTO_STORAGE_DIR=./private-photos
PHOTO_MAX_BYTES=8388608
PHOTO_MAX_PIXELS=20000000
PHOTO_CREDENTIAL_DAYS=90
PHOTO_PUSH_ENABLED=false
# Set this in the SERVER process environment when enabling FCM. Do not commit the file.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
