# Guardian — environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.

# --- ElevenLabs (voice calls) ---
# Get/rotate at: ElevenLabs dashboard -> Profile -> API Keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_AGENT_ID=your_conversational_agent_id_here
ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id_here

# --- MedGemma (clinical brain) ---
# Local Ollama default, or your DigitalOcean GPU droplet URL
MEDGEMMA_URL=http://localhost:11434
MEDGEMMA_MODEL=medgemma-4b-it
# Hugging Face token (MedGemma is a gated model)
HF_TOKEN=your_huggingface_token_here

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+10000000000

# --- Database (Postgres on DigitalOcean) ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/guardian

# --- Email (SendGrid or Resend) ---
EMAIL_API_KEY=your_email_provider_key_here
EMAIL_FROM=guardian@example.com

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000

# --- Patient photo sync (see PHOTO_SYNC.md) ---
# Private writable persistent directory; never expose through a static web server.
PHOTO_STORAGE_DIR=./private-photos
PHOTO_MAX_BYTES=8388608
PHOTO_MAX_PIXELS=20000000
PHOTO_CREDENTIAL_DAYS=90
PHOTO_PUSH_ENABLED=false
# Set this in the SERVER process environment when enabling FCM. Do not commit the file.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
