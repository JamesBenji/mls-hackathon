# Copy values to Coolify resource environment settings, not a browser build.
# REQUIRED: independently generate each using `openssl rand -hex 32` (locally).
# Empty placeholders intentionally make Compose refuse deployment.
GUARDIAN_API_KEY=
POSTGRES_PASSWORD=
PUBLIC_BASE_URL=https://medicall.nulkode.dev
TIMEZONE=Europe/Berlin
MOCK_TELEPHONY=true
PHOTO_PUSH_ENABLED=false
# Exact dashboard/browser origins only, comma separated; no wildcard.
CORS_ORIGINS=
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
ELEVEN_API_KEY=
ELEVEN_AGENT_ID=agent_5201m5q0f0e5e17asvhek5vz3v6a
# One-off calling branch. Its normal agent duration applies unless explicitly overridden.
# Photo calls also need request_photo/check_photo_status with session-bound headers.
ELEVEN_IMMEDIATE_CALL_BRANCH_ID=
ELEVEN_AGENT_PHONE_NUMBER_ID=phnum_2101m5pxtpy0ecv86y3d8s5asqhy
ELEVEN_WEBHOOK_SECRET=
ELEVEN_TOOL_AUTH_TOKEN=
# Optional SMS; all credentials stay server-side.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Only when using firebase.compose.yaml; absolute path on Docker HOST, not laptop.
# FIREBASE_CREDENTIALS_HOST_PATH=/opt/medicall/secrets/firebase-service-account.json
